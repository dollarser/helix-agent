<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- HXA-044: the in-APK LYING ContentProvider (doc 07: SAF provider 谎报
             size/MIME/display name). Same APK as the tests, so no export/permission is
             needed; the tests drive it through the REAL ContentResolver adapters. -->
        <provider
            android:name="com.helix.feature.files.test.LyingContentProvider"
            android:authorities="com.helix.feature.files.test"
            android:exported="false" />

        <!-- HXA-057: the in-APK FIXED SAF document tree (a small root/ tree) the tests drive the
             REAL ContentResolverSafTreeReader against through the real ContentResolver. Same APK
             as the tests, so no export/permission is needed. -->
        <provider
            android:name="com.helix.feature.files.test.TreeDocumentsProvider"
            android:authorities="com.helix.feature.files.tree"
            android:exported="false" />

        <!-- HXA-058: the in-APK MUTABLE SAF document tree (the export destination side: the
             create-document insert + read/write openFile). Same APK as the tests. -->
        <provider
            android:name="com.helix.feature.files.test.ExportSinkTreeProvider"
            android:authorities="com.helix.feature.files.exportsink"
            android:exported="false" />
    </application>
</manifest>
