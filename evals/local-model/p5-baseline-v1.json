{
  "schemaVersion": 1,
  "suite": "local-model-p5",
  "description": "Qwen3 4B real-model baseline. Runtime/probe success and task correctness are separate facts.",
  "runtime": {
    "backend": "llama.cpp CPU",
    "threads": 2,
    "sampling": "greedy",
    "contextTokens": 4096,
    "observable": [
      "coldLoadMs",
      "warmReuseMs",
      "loadAndInspectMs",
      "generationWallMs",
      "inputTokens",
      "outputTokens",
      "effectiveEndToEndOutputTokensPerSecond",
      "sampledPeakPssKiB",
      "sampledPeakRssKiB",
      "cancelToExitMs",
      "unloadMs",
      "reloadMs",
      "terminateMs"
    ],
    "unobservableWithoutNativeProtocolChange": [
      "prefillMs",
      "trueFirstTokenMs",
      "decodeOnlyMs",
      "decodeTokensPerSecond"
    ]
  },
  "measurement": {
    "taskTimeoutSeconds": 1800,
    "memorySampleSeconds": 1,
    "loadedIdleMilliseconds": 3000,
    "qualityPassRequiresDurableCompletedTurn": true
  },
  "cases": [
    {
      "id": "no-tool-text",
      "source": "LocalModelRealTaskDeviceTest capability probe",
      "oracle": "exact trimmed text equals 'ok' and generation completes"
    },
    {
      "id": "tool-capability",
      "source": "LocalModelRealTaskDeviceTest capability probe",
      "oracle": "real production capability probe passes a local tool-call round"
    },
    {
      "id": "file-aggregation",
      "source": "LocalModelRealTaskDeviceTest#realModelCompletesFileWorkflow",
      "oracle": "East=150/10/140; West=120/20/100; grand net=240; both outputs read after final write"
    },
    {
      "id": "minimal-write-read-reopen",
      "source": "FirstSuccessJourneyDeviceTest#firstSuccessSurvivesProcessDeathWithoutReexecution",
      "oracle": "write/read each once, exact artifact bytes, process restart restores durable facts without replay"
    },
    {
      "id": "cancel-exit-lifecycle",
      "source": "LocalModelPerformanceLifecycleDeviceTest#recordsCancelUnloadReloadAndTerminateLatencies",
      "oracle": "caller cancellation reaches runtime exit, then unload/reload/terminate leave no active generation"
    }
  ]
}
