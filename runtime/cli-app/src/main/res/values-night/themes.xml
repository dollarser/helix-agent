<?xml version="1.0" encoding="utf-8"?>
<!--
  HXA-191 dark-theme variant of Theme.Helix.Subscription (see ../values/themes.xml for the
  light baseline). This is the ANDROID WINDOW side for the developer subscription / login face
  (a native-View shell in the :subscriptions process, NOT a Compose surface): it makes the window
  background and the status/navigation bars track the system dark mode. The face's native View
  content colors are a documented residual boundary (not night-aware in this Compose-centric
  slice). Values are the Material3 dark counterparts of the light ones:
  - parent android:Theme.Material.NoActionBar (dark) -> dark window background;
  - colorAccent #6750A4 (light primary) -> #D0BCFF (dark primary);
  - surface #FFFBFE (light) -> #1C1B1F (dark) for window/status/navigation bars;
  - windowLightStatusBar / windowLightNavigationBar true (light icons off) -> false (light
    icons on the dark bars).
-->
<resources>
    <style name="Theme.Helix.Subscription" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#D0BCFF</item>
        <item name="android:windowBackground">#FF1C1B1F</item>
        <item name="android:statusBarColor">#FF1C1B1F</item>
        <item name="android:navigationBarColor">#FF1C1B1F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
