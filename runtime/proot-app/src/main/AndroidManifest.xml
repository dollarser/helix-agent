<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0049: private developer services share the host UID. PRoot is not an offline sandbox. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <service android:name="com.helix.runtime.proot.app.ProotRuntimeService"
            android:process=":proot" android:exported="false" />
        <receiver android:name="com.helix.runtime.proot.app.ProotJobStopReceiver"
            android:process=":proot" android:exported="false" />
        <activity android:name="com.helix.runtime.proot.app.ProotRepairActivity"
            android:process=":proot" android:exported="false" android:excludeFromRecents="true" />
        <activity android:name="com.helix.runtime.proot.app.ProotLegalActivity"
            android:process=":proot" android:exported="false" android:excludeFromRecents="true" />
    </application>
</manifest>
