<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <activity android:name="com.helix.app.eval.BackgroundDisplayFixtureActivity"
            android:exported="true" android:label="Helix background fixture">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name="com.helix.app.eval.CapabilityFixtureStateProvider"
            android:authorities="${applicationId}.capability-state" android:exported="true" />
        <activity android:name="com.helix.app.eval.TouchReviewActivity" android:exported="true" />
        <activity android:name="com.helix.app.eval.AutomationInstallSourceActivity" android:exported="true" />
        <provider android:name="com.helix.app.eval.AutomationInstallFixtureProvider" android:authorities="${applicationId}.installfixture" android:exported="false" android:grantUriPermissions="true">
        </provider>
        <!-- Synthetic UI in the test APK, launched from the different target-app UID. -->
        <activity android:name="com.helix.app.eval.AutomationEvaluationActivity" android:exported="true" />
    </application>
</manifest>
