<?xml version="1.0" encoding="utf-8"?>
<!--
  HXA-191 dark-theme variant of Theme.Helix (see ../values/themes.xml for the light
  baseline). This is the ANDROID WINDOW side of the system-following theme. The COMPOSE side is
  wired explicitly in Theme.kt (HelixTheme): material3 1.4's MaterialTheme composable does NOT
  read the system night mode — a bare MaterialTheme {} resolves to a FIXED light colorScheme — so
  HelixTheme selects the dark/light scheme from isSystemInDarkTheme() at both composition roots.
  This platform theme makes the WINDOW match that scheme so the system bars and the pre-Compose
  window background are correct in dark mode too:

  - parent android:Theme.Material.NoActionBar (the dark platform theme) supplies a dark
    window background, so there is no light flash before Compose draws;
  - the status/navigation bar colors and the windowLightStatusBar flag are the dark
    counterparts of the light values in ../values/themes.xml (light bars #FFF9F9 +
    windowLightStatusBar=true here become dark bars #FF1C1B1F — the Material3 dark
    surface — + windowLightStatusBar=false, i.e. light icons on the dark bars).
  - windowLightNavigationBar is intentionally left to the platform default (false = light
    icons), which is correct for the dark navigation bar, exactly mirroring the light theme
    which relies on the default there.
-->
<resources>
    <style name="Theme.Helix" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">#FF1C1B1F</item>
        <item name="android:statusBarColor">#FF1C1B1F</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
