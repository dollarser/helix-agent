<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Goal checkpoint reminders are deferrable notifications (architecture doc 5.1).
         POST_NOTIFICATIONS is a normal (non-dangerous) runtime permission, required on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Provider connectivity (provider doc section 2): all model traffic is outbound
         HTTPS/cleartext-LAN from the app; no location/contact/sms permission is implied.
         HXA-027 needs it for the developer instrumented smoke; HXA-028 wires the same
         permission into the production provider UI for both variants. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".HelixApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_helix"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Helix"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- HXA-056 share drafts: receiving a share from another app lands a LOCAL DRAFT
                 (text pre-filled / images imported + staged, never auto-sent — ADR-0014 §5).
                 text/plain and image/* only; other share types do not list Helix. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- HXA-046 share: hands a file (workspace or all-files root) to another app via a
             content:// URI. Unexported + grantUriPermissions: the receiving app gets a scoped,
             read-only grant, not the app's filesystem. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
