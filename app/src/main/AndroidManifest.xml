<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Goal checkpoint reminders are deferrable notifications (architecture doc 5.1).
         POST_NOTIFICATIONS is a normal (non-dangerous) runtime permission, required on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Provider connectivity (provider doc section 2): all model traffic is outbound
         HTTPS/cleartext-LAN from the app; no location/contact/sms permission is implied.
         HXA-027 needs it for the developer instrumented smoke; HXA-028 wires the same
         permission into the production provider UI for both variants. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".HelixApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_helix"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Helix"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
