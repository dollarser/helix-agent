<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <queries>
        <package android:name="com.helix.runtime.cli" />
    </queries>
    <!--
        HXA-083 (developer flavor only): use the companion's signature-level bind
        permission. It is granted only because the developer app and
        com.helix.runtime.proot are signed by the same set key; the consumer
        (Play) variant has no PRoot client and declares nothing here.
    -->
    <uses-permission android:name="com.helix.permission.BIND_PROOT_RUNTIME" />
    <uses-permission android:name="com.helix.permission.BIND_CLI_RUNTIME" />
    <application
        android:networkSecurityConfig="@xml/network_security_config">
        <meta-data
            android:name="com.helix.agent.DEVELOPER_VARIANT"
            android:value="HELIX_DEVELOPER_ONLY_APP" />
    </application>
</manifest>
