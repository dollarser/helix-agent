<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The developer CLI-runtime device tests look up the companion runtime packages by
         name; on API 30+ the instrumentation (test package) uid sees a package only when
         this manifest declares it, so the lookup degrades to NOT_INSTALLED without these. -->
    <queries>
        <package android:name="com.helix.runtime.cli" />
        <package android:name="com.helix.runtime.proot" />
    </queries>

    <application>
        <!-- HXA-058: the document fixtures for the file-manager import/export device tests.
             exported=true is REQUIRED and safe here: the app module's instrumentation runs in
             the APP process (com.helix.agent), while this provider belongs to the TEST package
             (com.helix.agent.test) — a DIFFERENT uid, so an exported=false provider is
             unreachable from the app process (device-verified: "Permission Denial ... not
             exported from UID ..."). The test APK is never shipped (connectedAndroidTest
             installs it only on dev machines), so exporting a dev-only synthetic-data provider
             has no production surface. (In-process registration via
             ContentResolver.registerContentProvider is not possible: the method is absent from
             the SDK stubs — framework-internal only.) -->
        <provider
            android:name="com.helix.app.test.TransferTestDocumentsProvider"
            android:authorities="${applicationId}.transfersink"
            android:exported="true" />
        <provider android:name="com.helix.app.test.ManualFilesTestProvider"
            android:authorities="${applicationId}.manualfiles" android:exported="true" />
    </application>
</manifest>
